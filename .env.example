# Copy to .env. Never commit real secrets.

# Core
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-at-least-32-random-characters

# Auth
ALLOWED_EMAIL_DOMAIN=college.edu
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Datastores
DATABASE_URL=postgresql+psycopg://campusmind:campusmind@localhost:5432/campusmind
REDIS_URL=redis://localhost:6379/0

# LLM: anthropic (hosted) or ollama (local)
LLM_PROVIDER=ollama
LLM_MODEL=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=120
# Parallel LLM calls in the summarizer. Use 1 with Ollama, which queues requests by default.
LLM_MAX_CONCURRENCY=5

# Ingestion
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
OCR_MIN_CHARS=50
TESSERACT_CMD=
NEAR_DUPLICATE_THRESHOLD=0.7

# Vector store: chroma or qdrant
VECTOR_BACKEND=chroma
CHROMA_PATH=./data/chroma
# Set CHROMA_HOST to use a Chroma server. Needed once an API and a worker run together.
CHROMA_HOST=
CHROMA_PORT=8000
QDRANT_URL=http://localhost:6333

# Retrieval
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_ENABLED=false
RRF_VECTOR_WEIGHT=1.0
RRF_BM25_WEIGHT=1.0

# Conversations. Older ones are deleted. 0 keeps everything.
CONVERSATION_RETENTION_DAYS=365

# RAG
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.45
RAG_MIN_RESULTS=3
RAG_CONTEXT_TOKENS=6000
RAG_CACHE_TTL_SECONDS=3600
RAG_FOLLOWUPS_ENABLED=true

# Email. Leave SMTP_HOST empty to log messages instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=CampusMind <no-reply@campusmind.local>
