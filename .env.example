# Copy to .env. Never commit real secrets.

# Core
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-at-least-32-random-characters

# Datastores
DATABASE_URL=postgresql+psycopg://campusmind:campusmind@localhost:5432/campusmind
REDIS_URL=redis://localhost:6379/0

# LLM: anthropic (hosted) or ollama (local)
LLM_PROVIDER=ollama
LLM_MODEL=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=120

# Ingestion
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
OCR_MIN_CHARS=50
TESSERACT_CMD=
NEAR_DUPLICATE_THRESHOLD=0.7
